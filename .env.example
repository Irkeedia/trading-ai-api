# ============================================================
# Trading IA - Variables d'environnement
# Copiez ce fichier en .env et remplissez vos clés
# ============================================================

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Binance (exemple) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_here

# --- Kraken (exemple) ---
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=

# --- Coinbase (exemple) ---
COINBASE_API_KEY=
COINBASE_SECRET_KEY=

# --- News API (optionnel) ---
NEWS_API_KEY=

# --- Mode de trading ---
# PAPER = simulation, LIVE = réel
TRADING_MODE=PAPER

# --- Base de données Neon PostgreSQL ---
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- API ---
# Clé secrète : si différente de « change-me-in-production », les routes sensibles
# (POST /api/engine/control, /api/exchange/keys) exigent le header X-API-Key avec cette valeur.
API_SECRET_KEY=your_api_secret_key_here
# Origines autorisées CORS (séparées par des virgules, pas d'espace après la virgule si possible).
CORS_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app
